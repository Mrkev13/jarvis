# --------------------------------------------------
# Standa Hub — Frontend ENV template
# --------------------------------------------------
# ZKOPÍRUJ tento soubor jako '.env.local' a DOPLŇ svou
# Tailscale IP (100.x.x.x formát — viz 'tailscale ip -4').
#
# Pro localhost / lokální vývoj můžeš ponechat 127.0.0.1.
# --------------------------------------------------

# ===== LOKÁLNÍ VÝVOJ (bez Tailscale) =====
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ===== TAILSCALE (přístup z mobilu / druhého PC) =====
# ↓↓↓ SEM DEJ SVŮJ TAILSCALE IP (4. blok, např. 100.64.1.23) ↓↓↓
NEXT_PUBLIC_API_URL=http://100.XXX.XXX.XXX:8000

# ===== HTTPS přes Tailscale Serve (nutné pro Web Push upozornění na mobilu, Phase E) =====
# Stránka přes https nesmí volat API přes http → i backend přes Tailscale Serve (viz backend/AGENTS.md kap. 21):
# NEXT_PUBLIC_API_URL=https://TVUJ-PC.TVUJ-TAILNET.ts.net:8443
# NEXT_DEV_EXTRA_ORIGINS=TVUJ-PC.TVUJ-TAILNET.ts.net

# ===== Moduly – feature flagy (Roadmap 6C, lib/moduleConfig.ts) =====
# Vkládají se do prohlížeče při `next build` (nejsou tajné) → po změně znovu build. Hodnoty jako backend
# (MODULE_<ID>_ENABLED v backend/.env): 1/true/yes/on, 0/false/no/off; prázdné/nesmysl = výchozí.
# NEXT_PUBLIC_MODULE_SCHOOL_ENABLED=true
# NEXT_PUBLIC_MODULE_WORK_ENABLED=true
# NEXT_PUBLIC_MODULE_FINANCE_ENABLED=true
# NEXT_PUBLIC_MODULE_GOALS_ENABLED=true
# NEXT_PUBLIC_MODULE_WOT_ENABLED=true
# NEXT_PUBLIC_MODULE_MFF_ENABLED=true
# NEXT_PUBLIC_MODULE_FOOD_ENABLED=false
# NEXT_PUBLIC_MODULE_FITNESS_ENABLED=false
# NEXT_PUBLIC_MODULE_HABITS_ENABLED=false
# NEXT_PUBLIC_MODULE_PROJECTS_ENABLED=false
# NEXT_PUBLIC_MODULE_KNOWLEDGE_ENABLED=false
# NEXT_PUBLIC_MODULE_CAR_ENABLED=false
# NEXT_PUBLIC_MODULE_TRAVEL_ENABLED=false
# NEXT_PUBLIC_MODULE_ENTERTAINMENT_ENABLED=false
