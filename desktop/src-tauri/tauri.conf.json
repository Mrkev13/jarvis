{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis pro PC",
  "version": "0.1.0",
  "identifier": "cz.standahub.jarvis-agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jarvis pro PC",
        "width": 480,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Jarvis pro PC – agent Standa Hubu",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Czech"]
      }
    }
  }
}
