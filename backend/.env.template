# --------------------------------------------------
# Standa Hub — Backend ENV template
# --------------------------------------------------
# ZKOPÍRUJ tento soubor jako '.env' a DOPLŇ hodnoty.
# Uzavřená hesla / tokeny sem, NIKOLI do Gitu.
# --------------------------------------------------

# ===== Backend =====
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/standa_hub
# nebo pro SQLite: sqlite+pysqlite:///./standa-hub.db
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GROQ_API_KEY=
OPENAI_API_KEY=

# ===== LLM (Groq, OpenAI-kompatibilní API) – prázdné = výchozí hodnota =====
# Model pro chat / tool calling (default openai/gpt-oss-120b)
GROQ_MODEL=
# Model pro budoucí shrnutí konverzací (default = GROQ_MODEL)
GROQ_SUMMARY_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Odhad fixní režie requestu (system prompt + tool schémata); nad limit = warning v logu (default 3500)
AI_MAX_FIXED_TOKENS=3500
# Prefetch CURRENT STATE kontext (A3): cíl a tvrdé maximum odhadovaných tokenů (default 500 / 600)
AI_CONTEXT_TARGET_TOKENS=500
AI_MAX_CONTEXT_TOKENS=600
# Historie konverzace (A4): posledních N zpráv doslovně; starší se shrnou, když neshrnuté přesáhnou práh.
# Shrnutí používá GROQ_SUMMARY_MODEL. Musí platit MAX_SUMMARY + TRIGGER <= MAX_HISTORY.
AI_HISTORY_WINDOW_MESSAGES=8
AI_SUMMARY_TRIGGER_TOKENS=1000
AI_MAX_SUMMARY_TOKENS=300
AI_MAX_HISTORY_TOKENS=2500
# Routing toolů (A5): true = posílat jen tooly relevantní pro dotaz (write tooly jen při write záměru);
# false = vždy všechny tooly jako před A5 (kill switch)
AI_TOOL_ROUTING=true
# Retry: SDK retry vypnuté (0) → každý 429/5xx jde přes aplikační retry a je vidět v logu
GROQ_SDK_MAX_RETRIES=0
# Celkový počet pokusů na jedno LLM volání (default 3); max čekání po 429 v sekundách (default 20)
AI_LLM_MAX_ATTEMPTS=3
AI_LLM_RETRY_MAX_WAIT_SECONDS=20
# Log využití LLM (jen čísla: tokeny, latence, kola, rate-limit, retry; nikdy obsah) – default true
AI_USAGE_LOG=true
# Klíč: GROQ_API_KEY, pokud chybí, použije se OPENAI_API_KEY (Groq je OpenAI-kompatibilní)

# ===== Alembic =====
RUN_ALEMBIC_UPGRADE_AT_STARTUP=true

# ===== Scheduler =====
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600
# Připomínky (Phase D): lehký job ve stejném scheduleru, běží i bez hodinového jobu (default true / 60 s, min 15)
REMINDERS_CHECK_ENABLED=true
REMINDERS_CHECK_SECONDS=60

# Denní přehled (Phase F): jeden AI přehled na pražský den v DAILY_BRIEFING_TIME (HH:MM, Europe/Prague).
# Po restartu se zmeškaný přehled dogeneruje (jen pro dnešek). DAILY_BRIEFING_PUSH=false = jen zvonek, bez Web Push.
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=07:00
DAILY_BRIEFING_PUSH=true
DAILY_BRIEFING_CHECK_SECONDS=300

# Týdenní přehled (Phase G): jeden přehled na pražský týden (po–ne). Generuje se WEEKLY_REVIEW_DAY
# (MON…SUN) v WEEKLY_REVIEW_TIME a shrnuje týden „do teď"; chybějící přehled minulého týdne se po startu dožene.
WEEKLY_REVIEW_ENABLED=true
WEEKLY_REVIEW_DAY=SUN
WEEKLY_REVIEW_TIME=19:00
WEEKLY_REVIEW_PUSH=true
WEEKLY_REVIEW_CHECK_SECONDS=900

# ===== Externí doručení – Web Push (Phase E) =====
# Klíče vygeneruj: python backend/scripts/generate_vapid_keys.py  (NIKDY necommitovat; prázdné = vypnuto)
EXTERNAL_DELIVERY_ENABLED=true
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_CONTACT=mailto:you@example.com
# Další povolené push služby (čárkou), jen když prohlížeč používá jinou než FCM/Mozilla/Apple/Windows
WEB_PUSH_EXTRA_HOSTS=
# SINGLE WORKER WARNING:
# Scheduler podporuje pouze 1 backend worker.
# Používej: uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
# Pokud spustíš více workers, hourly job poběží X×.

# ===== Backup =====
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_HOUR_OF_DAY=3
BACKUP_RETENTION_DAYS=30
# Cesta k pg_dump(.exe), když není v PATH. Prázdné = PATH, na Windows pak standardní instalace
# %ProgramFiles%/PostgreSQL/<verze>/bin (nejvyšší verze). Nastavená, ale neexistující cesta = chyba zálohy.
PG_DUMP_PATH=

# ===== Média (Game Enrichment B) =====
# Screenshoty milníků WoT: MEDIA_DIR/wot-screenshots/<uuid>.<png|jpg|webp>, metadata v DB.
# Nejsou v Gitu ani v DB dumpu; normální backup run je inkrementálně archivuje s SHA-256.
# Replaye WoT (Game Enrichment C): MEDIA_DIR/wot-replays/<uuid>.wotreplay – originály beze změny
# (viz docs/wot-replays.md).
MEDIA_DIR=./media
WOT_SCREENSHOT_MAX_MB=10
WOT_REPLAY_MAX_MB=50

# ===== Auth =====
AUTH_PIN_HASH=
AUTH_COOKIE_NAME=standa_hub_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_MINUTES=1440

# ===== Moduly – feature flagy (Roadmap 6C, module_registry.py, docs/module-feature-flags.md) =====
# Jen dostupnost modulu (navigace, vyhledávání, Dnes, Rychlé přidání, dashboard, AI kontext, REST 404), NE oprávnění.
# 1/true/yes/on = zapnuto, 0/false/no/off = vypnuto; prázdné nebo nesmysl = výchozí hodnota (překlep nic neschová).
# Stejné hodnoty nastav i ve frontend/.env.local (NEXT_PUBLIC_MODULE_<ID>_ENABLED, platí po novém buildu).
# Hotové moduly (výchozí zapnuto):
# MODULE_SCHOOL_ENABLED=true
# MODULE_WORK_ENABLED=true
# MODULE_FINANCE_ENABLED=true
# MODULE_GOALS_ENABLED=true
# MODULE_WOT_ENABLED=true
# MODULE_MFF_ENABLED=true
# Budoucí moduly (výchozí vypnuto; dokud nejsou implementované, flag true nic neodkryje):
# MODULE_FOOD_ENABLED=false
# MODULE_FITNESS_ENABLED=false
# MODULE_HABITS_ENABLED=false
# MODULE_PROJECTS_ENABLED=false
# MODULE_KNOWLEDGE_ENABLED=false
# MODULE_CAR_ENABLED=false
# MODULE_TRAVEL_ENABLED=false
# MODULE_ENTERTAINMENT_ENABLED=false
