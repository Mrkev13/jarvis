# --------------------------------------------------
# Standa Hub — Backend ENV template
# --------------------------------------------------
# ZKOPÍRUJ tento soubor jako '.env' a DOPLŇ hodnoty.
# Uzavřená hesla / tokeny sem, NIKOLI do Gitu.
# --------------------------------------------------

# ===== Backend =====
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/standa_hub
# nebo pro SQLite: sqlite+pysqlite:///./standa-hub.db
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GROQ_API_KEY=
OPENAI_API_KEY=

# ===== Alembic =====
RUN_ALEMBIC_UPGRADE_AT_STARTUP=true

# ===== Scheduler =====
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600
# SINGLE WORKER WARNING:
# Scheduler podporuje pouze 1 backend worker.
# Používej: uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
# Pokud spustíš více workers, hourly job poběží X×.

# ===== Backup =====
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_HOUR_OF_DAY=3
BACKUP_RETENTION_DAYS=30

# ===== Auth =====
AUTH_PIN_HASH=
AUTH_COOKIE_NAME=standa_hub_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_MINUTES=1440
