# Copy outside tracked files; fill locally. No values/secrets are supplied here.
# Required: APP_ENV must be production; PostgreSQL only; explicit separate DB confirmation.
APP_ENV=
DATABASE_URL=
PRODUCTION_DATABASE_NAME=
FRONTEND_ORIGINS=
AUTH_PIN_HASH=
# Absolute production directories, never development fallback.
MEDIA_DIR=
BACKUP_DIR=
# Required for client construction; use a dummy ONLY in socket-blocked cloud validation.
GROQ_API_KEY=
# Explicit booleans required. BACKUP_ENABLED=true requires SCHEDULER_ENABLED=true.
SCHEDULER_ENABLED=
REMINDERS_CHECK_ENABLED=
DAILY_BRIEFING_ENABLED=
WEEKLY_REVIEW_ENABLED=
EXTERNAL_DELIVERY_ENABLED=
BACKUP_ENABLED=
# Required false. Run Alembic deliberately before service start.
RUN_ALEMBIC_UPGRADE_AT_STARTUP=
# Optional runtime metadata: APP_COMMIT auto-resolves from git once at launcher startup if blank.
APP_VERSION=
APP_COMMIT=
# Optional native configuration; see .env.template for remaining modules/settings.
AUTH_COOKIE_SECURE=
PG_DUMP_PATH=
BACKUP_HOUR_OF_DAY=
BACKUP_RETENTION_DAYS=
# Existing safe MRK-26 logger; absolute protected local file, directory pre-created.
MONITORING_LOG_PATH=
# Optional private Calendar feed, never returned by health.
MOODLE_ICS_URL=
