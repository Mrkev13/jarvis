# Copy to backend/.env.production. Compose overrides DB/path values explicitly.
APP_ENV=production
DATABASE_URL=
PRODUCTION_DATABASE_NAME=standa_hub_prod
FRONTEND_ORIGINS=
AUTH_PIN_HASH=
AUTH_COOKIE_NAME=standa_hub_session
AUTH_COOKIE_SECURE=true
MEDIA_DIR=/data/media
BACKUP_DIR=/data/backups
RUN_ALEMBIC_UPGRADE_AT_STARTUP=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600
REMINDERS_CHECK_ENABLED=true
REMINDERS_CHECK_SECONDS=60
BACKUP_ENABLED=true
BACKUP_HOUR_OF_DAY=3
BACKUP_RETENTION_DAYS=30
HEALTH_BACKUP_MAX_AGE_HOURS=36
# Safe default: AI and external delivery are disabled until deliberately configured.
DAILY_BRIEFING_ENABLED=false
WEEKLY_REVIEW_ENABLED=false
EXTERNAL_DELIVERY_ENABLED=false
# Required only to construct the existing AI client. This is NOT a real key.
GROQ_API_KEY=disabled-placeholder
GROQ_BASE_URL=http://127.0.0.1:9
# To enable AI later, set a real key/base URL privately and opt into scheduled AI.
