# Example only. Never use without replacing credentials and validation.
# Copy to the ignored backend/.env.production for Docker deployment.
# Scheduler, delivery and backups are disabled for initial recovery.
# Required: APP_ENV must be production; PostgreSQL only; explicit separate DB confirmation.
APP_ENV=production
DATABASE_URL=postgresql+psycopg2://standa_hub:REPLACE_WITH_URL_ENCODED_PASSWORD@standa-postgres:5432/standa_hub
PRODUCTION_DATABASE_NAME=standa_hub
FRONTEND_ORIGINS=https://standa-server.tail068a4b.ts.net
AUTH_PIN_HASH=
# Absolute production directories, never development fallback.
MEDIA_DIR=/data/media
BACKUP_DIR=/data/backups
# Required for client construction; use a dummy ONLY in socket-blocked cloud validation.
GROQ_API_KEY=
# Explicit booleans required. BACKUP_ENABLED=true requires SCHEDULER_ENABLED=true.
SCHEDULER_ENABLED=false
REMINDERS_CHECK_ENABLED=false
DAILY_BRIEFING_ENABLED=false
WEEKLY_REVIEW_ENABLED=false
EXTERNAL_DELIVERY_ENABLED=false
BACKUP_ENABLED=false
# Required false. Run Alembic deliberately before service start.
RUN_ALEMBIC_UPGRADE_AT_STARTUP=false
# Optional runtime metadata: APP_COMMIT auto-resolves from git once at launcher startup if blank.
APP_VERSION=
APP_COMMIT=
# Optional native configuration; see .env.template for remaining modules/settings.
# MRK-24 HTTPS (Tailscale Serve): FRONTEND_ORIGINS gets https://<host>.<tailnet>.ts.net and this must be true;
# validated at start (https origin <-> Secure cookie). Plain HTTP only: leave blank/false. docs/https-pwa-push.md
AUTH_COOKIE_SECURE=true
# MRK-73 (optional): 127.0.0.1,::1 behind Tailscale Serve = PIN rate limit per device. Blank = one shared limit.
AUTH_TRUSTED_PROXIES=
# Web Push (server-side only; generate with backend/scripts/generate_vapid_keys.py). Private key never leaves here.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_CONTACT=
PG_DUMP_PATH=
BACKUP_HOUR_OF_DAY=
BACKUP_RETENTION_DAYS=
# Existing safe MRK-26 logger; absolute protected local file, directory pre-created.
MONITORING_LOG_PATH=
# MRK-57 off-machine backups (restic -> Backblaze B2). Paths only - credentials live in the protected files created by
# scripts/windows/offsite-secrets.ps1 (SYSTEM + Administrators), never here or in git. docs/offsite-backups.md
OFFSITE_BACKUP_ENABLED=false
OFFSITE_RESTIC_PATH=
OFFSITE_SECRETS_FILE=
OFFSITE_RESTIC_PASSWORD_FILE=
# Whole-cycle deadline in seconds (code default 3600). Recommended 1200: a cycle takes <1 min today, and on a B2
# outage restic retries until this deadline, holding the hourly job that long.
OFFSITE_TIMEOUT_SECONDS=
# Optional private Calendar feed, never returned by health.
MOODLE_ICS_URL=
# MRK-77 (optional): Google Calendar secret iCal address, read-only. Never paste it anywhere else.
GOOGLE_ICS_URL=
